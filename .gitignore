!/FL-DNA/artifacts/priority34b/report_post_exit_pre_admin.md
/FL-DNA/reports/*.bib
/FL-DNA/protocols/*.bib

# Personal files never published
/Slides/
/session_chatgpt.md
/sessionchatgpt.md.save

