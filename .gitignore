# Paper sources and PDFs are kept out of the repository
/Latex/
/fl_dna_overleaf_paper.tex

# Internal research plan and its snapshots stay local
/PROJECT.md
/FL-DNA/artifacts/**/PROJECT_*.md

# Only README, evidence reports/protocols and a few referenced notes are published
*.md
*.tex
*.bib
!/README.md
!/FL-DNA/reports/**
!/FL-DNA/protocols/**
!/FL-DNA/external_defenses/UPSTREAM.md
!/FL-DNA/external_defenses/REPRODUCTION_REPORT.md
!/FL-DNA/external_defenses/REFERENCE_ATTACKS_REPORT.md
